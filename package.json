{
  "name": "mongoball",
  "version": "1.0.0",
  "description": "Download MLB data from Retrosheet and Baseball Savant into MongoDB",
  "type": "module",
  "scripts": {
    "download": "npx tsx src/download-season.ts",
    "migrate": "npx tsx src/mongo/migrate.ts",
    "verify": "npx tsx src/mongo/verify.ts",
    "workflow": "./scripts/full-workflow.sh",
    "build": "tsc",
    "start": "node dist/download-season.js"
  },
  "keywords": [
    "mlb",
    "baseball",
    "retrosheet",
    "statcast",
    "savant",
    "mongodb",
    "mongoball"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^13.0.0",
    "mongodb": "^6.12.0"
  }
}
